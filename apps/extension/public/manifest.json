{
  "manifest_version": 3,
  "name": "CipherVault",
  "version": "2.0.0",
  "description": "Zero-knowledge password autofill for CipherVault.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CipherVault"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "idle"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["http://localhost:8080/*", "http://localhost:3001/*"],
  "externally_connectable": {
    "matches": ["http://localhost:8080/*", "http://localhost:5173/*", "http://127.0.0.1:8080/*", "https://vault.example.com/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  },
  "commands": {
    "open-ciphervault": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Open CipherVault"
    }
  }
}
