NODE_ENV=development
HOST=0.0.0.0
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://keywall:keywall@localhost:5432/keywall
AUTH_PEPPER=replace-with-at-least-32-random-characters
PRELOGIN_SECRET=replace-with-another-32-random-value
MFA_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64url
ALLOW_UNVERIFIED_LOGIN=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=security@keywall.local
EMAIL_DELIVERY=direct
ENABLE_ATTACHMENTS=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=keywall-attachments
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=keywall
S3_SECRET_KEY=replace-with-local-minio-password
